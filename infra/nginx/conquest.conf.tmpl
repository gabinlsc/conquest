# CONQUEST — géré par deploy.sh (ne pas éditer à la main : régénéré à chaque déploiement).
# Ce fichier ne touche à aucun autre site de la machine : un bloc `server` dédié à __DOMAIN__.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl__HTTP2_LISTEN__;
    listen [::]:443 ssl__HTTP2_LISTEN__;
    __HTTP2_DIRECTIVE__
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Le GeoJSON des villes pèse plusieurs Mo : compression indispensable.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/json application/geo+json text/css application/javascript image/svg+xml;

    client_max_body_size 64k;

    # Métriques Prometheus : jamais exposées publiquement.
    location ^~ /metrics {
        return 404;
    }

    # API REST. X-Forwarded-For est ÉCRASÉ (et non complété) par l'IP réelle : le serveur s'en sert pour le
    # contrôle de débit et la détection des fermes de comptes, un client ne doit pas pouvoir l'usurper.
    location /api/ {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Temps réel (Socket.IO : WebSocket + repli long-polling).
    location /ws/ {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    # Gros fichiers statiques (frontières, polices, worker de la carte) : cache navigateur 7 jours.
    location ~ ^/(geo|fonts|maplibre)/ {
        proxy_pass http://127.0.0.1:__WEB_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    location / {
        proxy_pass http://127.0.0.1:__WEB_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
