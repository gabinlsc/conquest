{$DOMAIN} {
	encode zstd gzip

	# API REST : le préfixe /api est conservé côté serveur.
	handle /api/* {
		reverse_proxy server:3001
	}

	# Temps réel (Phase 4) : les WebSockets sont proxifiés nativement par Caddy.
	handle /ws/* {
		reverse_proxy server:3001
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
