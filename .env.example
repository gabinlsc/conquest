# Copier en .env (dev local) — en production, deploy.sh génère ce fichier automatiquement.
# Ne JAMAIS committer .env.

NODE_ENV=development
LOG_LEVEL=info

# --- Reverse proxy (Caddy) ---
# Domaine public (DNS A -> IP du VPS). "localhost" = certificat local auto-signé.
DOMAIN=localhost

# --- Serveur ---
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
PUBLIC_URL=http://localhost:3000
# openssl rand -hex 32
SESSION_SECRET=change-me-change-me-change-me-change-me

# Durée d'une saison en semaines : à l'échéance le classement est figé et la carte repart de zéro.
SEASON_WEEKS=4

# Bots d'animation : font vivre la carte tant qu'il y a peu de joueurs (en pause au-delà de BOT_MAX_ONLINE connectés).
BOTS_ENABLED=false
BOT_COUNT=40
BOT_INTERVAL_MS=6000
BOT_MAX_ONLINE=20

# Supervision (Prometheus + Grafana, voir docker-compose.monitoring.yml) : MONITORING=1 pour l'activer.
MONITORING=0
GRAFANA_PASSWORD=
# Jeton facultatif pour lire /metrics depuis l'extérieur du réseau Docker.
METRICS_TOKEN=

# --- PostgreSQL / Redis ---
POSTGRES_USER=conquest
POSTGRES_PASSWORD=conquest
POSTGRES_DB=conquest
REDIS_PASSWORD=conquest
# En dev local (infra:up expose les ports sur 127.0.0.1). En Docker, compose les recompose.
DATABASE_URL=postgres://conquest:conquest@localhost:5432/conquest
REDIS_URL=redis://:conquest@localhost:6379

# Dev : le front (:3000) parle directement au serveur temps réel (:3001). En production, laisser vide
# (même origine, Caddy route /ws vers le serveur).
NEXT_PUBLIC_WS_URL=

# --- OAuth (Phase 2, optionnel) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
