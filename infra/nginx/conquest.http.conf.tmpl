# CONQUEST — géré par deploy.sh (ne pas éditer à la main : régénéré à chaque déploiement).
# Étape 1 : HTTP seul, le temps d'obtenir le certificat Let's Encrypt (défi par fichier).
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
